$ cat analyzer/data/config.toml

corpus = "analyzer/data/corpus/russian/monkeytype.json"
layouts = ["analyzer/data/layouts"]
corpus_configs = "analyzer/data"
trigram_precision = 1000
max_cores = 32

[weights]
lateral_penalty = 1.3
sfbs = -7
sfs = -1
stretches = -0.3
pinky_ring_bigrams = -0.2
inrolls = 2.5
outrolls = 2.4
onehands = 0.9
alternates = 0.4
alternates_sfs = 0.1
redirects = -3.4
redirects_sfs = -4.2
bad_redirects = -4.9
bad_redirects_sfs = -5.5

[weights.finger_weights]
lp = 1.4
lr = 3.6
lm = 4.8
li = 5.5
lt = 3.3
rt = 3.3
ri = 5.5
rm = 4.8
rr = 3.6
rp = 1.4

[weights.max_finger_use]
penalty = 0
pinky = 6
ring = 14
middle = 20
index = 20
thumb = 22

