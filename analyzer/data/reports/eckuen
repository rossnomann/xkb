[weights.finger_weights]
lp = 1.4
lr = 3.6
lm = 4.8
li = 5.5
lt = 3.3
rt = 3.3
ri = 5.5
rm = 4.8
rr = 3.6
rp = 1.4

[weights.max_finger_use]
penalty = 0
pinky = 6
ring = 14
middle = 20
index = 20
thumb = 22

